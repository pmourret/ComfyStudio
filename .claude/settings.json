{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "permissions": {
    "allow": [
      "Bash(cp PROD/lena.db PROD/lena.db.avant-j2-etape1.bak)",
      "Bash(mv PROD/lena.db PROD/lena.db.old)",
      "Bash(git add *)",
      "Bash(git mv *)",
      "Bash(git push *)",
      "Bash(H:/ComfyUI/ComfyUI_windows_portable/python_embeded/python.exe -c ' *)",
      "Bash(\"H:/ComfyUI/ComfyUI_windows_portable/python_embeded/python.exe\" AUTOMATION/run_batch.py --limit 1 --no-qc)",
      "Bash(\"H:\\\\ComfyUI\\\\ComfyUI_windows_portable\\\\python_embeded\\\\python.exe\" AUTOMATION/web/app.py --no-comfy --no-browser --port 8199)",
      "Bash(git commit -m ' *)"
    ],
    "deny": [
      "Read(INPUTS/**)",
      "Read(**/*.db)",
      "Read(**/*.db-wal)",
      "Read(**/*.db-shm)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/filter-verbose-output.sh"
          }
        ]
      }
    ]
  }
}
