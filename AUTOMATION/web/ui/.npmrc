# Portable toolchain: nothing under %APPDATA% / %LOCALAPPDATA%.
# These are a SAFETY NET only — AUTOMATION/tools/toolchain.py sets the same
# values as npm_config_* environment variables, which win whatever directory
# npm is launched from. A relative path here resolves against the caller's cwd,
# so it is only correct when npm runs from this directory.
cache=../../../.toolchain/npm-cache
fund=false
audit=false
update-notifier=false
